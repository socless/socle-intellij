<idea-plugin>
    <id>socless.socle</id>
    <name>Socle (Chisel)</name>
    <vendor url="https://github.com/socless/socle">socless</vendor>
    <description><![CDATA[
    Chisel IDE support: a View design action on each ChiselSim test opens the elaborated design in a
    panel beside the editor, and the schematic follows your cursor. The Socle tool window lists the
    project's tests (View design and Simulate on each), the design's instance hierarchy and the details
    of the selection.
    <p>Needs the Scala plugin, LSP4IJ, Java 21 or newer, and a Mill project with ChiselSim tests.
    The plugin bundles the Socle language server.
    See <a href="https://github.com/socless/socle-intellij">socless/socle-intellij</a>.</p>
    ]]></description>

    <!-- LSP4IJ first, and no classloader dependency on the Scala plugin: it bundles its own lsp4j-jsonrpc,
         and Socle must see LSP4IJ's copy or the server proxy cannot be built. Socle needs the Scala
         plugin installed (for the Scala language), not its classes. -->
    <depends>com.redhat.devtools.lsp4ij</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="socle" name="Socle" factoryClass="socle.intellij.lsp.SocleServerFactory">
            <description><![CDATA[The Socle language server: View design and Simulate on ChiselSim tests, and the live design panel.]]></description>
        </server>
        <languageMapping language="Scala" serverId="socle"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Socle" displayType="BALLOON"/>
        <fileEditorProvider implementation="socle.intellij.panel.SocleTabEditorProvider"/>
        <postStartupActivity implementation="socle.intellij.SocleStartup"/>
        <toolWindow id="Socle" anchor="left" icon="/icons/socleToolWindow.svg"
                    factoryClass="socle.intellij.toolwindow.SocleToolWindowFactory"/>
        <codeInsight.lineMarkerProvider language="Scala" implementationClass="socle.intellij.actions.SocleLineMarkerProvider"/>
        <applicationConfigurable parentId="tools" id="socle.settings" displayName="Socle"
                                 instance="socle.intellij.settings.SocleConfigurable"/>
    </extensions>

    <actions>
        <group id="socle.group" text="Socle" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="socle.showPanel" class="socle.intellij.actions.ShowPanelAction" text="Show Design Panel"
                    description="Show the Socle design panel on the last design"/>
            <action id="socle.showWaves" class="socle.intellij.actions.ShowWavesAction" text="Show Waveforms"
                    description="Show the last Simulate's waveforms in the Surfer tab (surfer-panel viewer)"/>
            <action id="socle.refreshTests" class="socle.intellij.actions.RefreshTestsAction" text="Refresh Tests"
                    description="Ask the Socle server for the project's ChiselSim tests again"/>
            <action id="socle.openSettings" class="socle.intellij.actions.OpenSettingsAction" text="Settings..."
                    description="Open Settings | Tools | Socle"/>
        </group>
    </actions>
</idea-plugin>
